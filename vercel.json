{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/people",
      "destination": "/people/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/p/:id(\\d+)",
      "destination": "/people#/person/:id",
      "permanent": false
    },
    {
      "source": "/help",
      "destination": "/people#/help",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/people",
      "permanent": false
    },
    {
      "source": "/calendar",
      "destination": "/people",
      "permanent": false
    },
    {
      "source": "/calendar/:path*",
      "destination": "/people",
      "permanent": false
    }
  ]
}
