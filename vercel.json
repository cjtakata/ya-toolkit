{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/people",
      "destination": "/people/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 15 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/people",
      "permanent": false
    },
    {
      "source": "/calendar",
      "destination": "/people",
      "permanent": false
    },
    {
      "source": "/calendar/:path*",
      "destination": "/people",
      "permanent": false
    }
  ]
}
